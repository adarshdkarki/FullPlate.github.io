<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Full Plate — Authentic Nepali Menu</title>
  <script src="https://jsdelivr.net" defer></script>
  <script src="https://tailwindcss.com"></script>
  <style>
    [x-cloak] { display: none !important; }
    body { font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }
  </style>
</head>
<body class="bg-stone-50 text-stone-800" x-data="menuApp()">

  <!-- HEADER & LOGO -->
  <header class="bg-white border-b border-stone-200 py-8 px-4 text-center shadow-sm">
    <div class="max-w-2xl mx-auto flex flex-col items-center">
      <!-- Logo Container -->
      <div class="w-32 h-32 mb-4 bg-stone-100 rounded-full flex items-center justify-center overflow-hidden border border-stone-200">
        <img src="logo_DXWRN0.png" alt="Full Plate Logo" class="w-full h-full object-contain" onerror="this.src='https://placehold.co'">
      </div>
      <h1 class="text-4xl font-serif font-bold text-amber-900 tracking-wide">Full Plate</h1>
      <p class="text-amber-800 font-medium tracking-widest text-xs uppercase mt-1">Authentic Nepali Menu</p>
      <div class="mt-2 text-xs text-stone-400 font-semibold tracking-wider">ESTD 2026</div>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="max-w-5xl mx-auto px-4 py-8 grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- MENU SECTIONS -->
    <div class="lg:col-span-2 space-y-10">
      <template x-for="(items, category) in menu" :key="category">
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-stone-150">
          <h2 class="text-2xl font-bold text-amber-900 border-b border-amber-100 pb-3 mb-6 capitalize" x-text="category"></h2>
          
          <div class="divide-y divide-stone-100">
            <template x-for="item in items" :key="item.id">
              <div class="py-5 first:pt-0 last:pb-0 flex flex-col sm:flex-row sm:justify-between sm:items-start gap-4">
                <div class="flex-1">
                  <div class="flex justify-between items-baseline gap-2">
                    <h3 class="text-lg font-bold text-stone-900" x-text="item.name"></h3>
                    <span class="text-lg font-bold text-amber-800 whitespace-nowrap" x-text="'$' + item.price"></span>
                  </div>
                  <p class="text-stone-600 text-sm mt-1 leading-relaxed" x-text="item.description"></p>
                  
                  <!-- Conditional Item Customizations -->
                  <div class="mt-3 flex flex-wrap gap-3" x-data="{ selectedOption: item.options ? item.options[0] : null }">
                    <!-- Preparation / Style Option -->
                    <template x-if="item.options">
                      <div>
                        <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Style:</label>
                        <select class="bg-stone-100 border border-stone-200 rounded px-2 py-1 text-xs font-medium text-stone-700 focus:outline-none focus:ring-1 focus:ring-amber-800" 
                                x-model="selectedOption"
                                @change="item.selectedOption = $event.target.value">
                          <template x-for="opt in item.options" :key="opt">
                            <option :value="opt" x-text="opt"></option>
                          </template>
                        </select>
                      </div>
                    </template>
                    
                    <!-- Protein/Variant Option -->
                    <template x-if="item.variants">
                      <div>
                        <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1">Choice of:</label>
                        <select class="bg-stone-100 border border-stone-200 rounded px-2 py-1 text-xs font-medium text-stone-700 focus:outline-none focus:ring-1 focus:ring-amber-800"
                                @change="item.selectedVariant = $event.target.value">
                          <template x-for="variant in item.variants" :key="variant">
                            <option :value="variant" x-text="variant"></option>
                          </template>
                        </select>
                      </div>
                    </template>
                  </div>
                </div>

                <!-- Add to Cart Button -->
                <div class="sm:pt-1">
                  <button @click="addToCart(item)" 
                          class="w-full sm:w-auto bg-amber-800 text-white font-semibold text-sm px-4 py-2 rounded-xl shadow-sm hover:bg-amber-900 transition active:transform active:scale-95 flex items-center justify-center gap-1">
                    <span>Add</span>
                    <span class="text-xs font-normal opacity-80">+</span>
                  </button>
                </div>
              </div>
            </template>
          </div>
        </div>
      </template>
    </div>

    <!-- CART SIDEBAR -->
    <div class="lg:col-span-1">
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-stone-150 sticky top-6">
        <h2 class="text-xl font-bold text-stone-900 border-b border-stone-100 pb-3 mb-4 flex justify-between items-center">
          <span>Your Order</span>
          <span class="bg-amber-100 text-amber-950 text-xs px-2 py-1 rounded-full font-bold" x-text="cartCount()"></span>
        </h2>

        <!-- Empty Cart State -->
        <div x-show="cart.length === 0" class="text-center py-10">
          <p class="text-stone-400 text-sm">Select items from the menu to start your order.</p>
        </div>

        <!-- Cart Items List -->
        <div x-show="cart.length > 0" class="divide-y divide-stone-100 max-h-96 overflow-y-auto pr-1" x-cloak>
          <template x-for="(cartItem, index) in cart" :key="index">
            <div class="py-3 flex justify-between items-start gap-2">
              <div class="flex-1">
                <h4 class="font-bold text-sm text-stone-900" x-text="cartItem.name"></h4>
                <p class="text-xs text-stone-500 mt-0.5" x-show="cartItem.customization" x-text="cartItem.customization"></p>
                <div class="text-sm font-semibold text-amber-800 mt-1" x-text="'$' + (cartItem.price * cartItem.quantity)"></div>
              </div>
              
              <!-- Quantity Controls -->
              <div class="flex items-center gap-2 bg-stone-100 rounded-lg p-1">
                <button @click="updateQuantity(index, -1)" class="w-6 h-6 flex items-center justify-center font-bold text-stone-600 hover:bg-stone-200 rounded transition">-</button>
                <span class="text-xs font-bold text-stone-800 w-4 text-center" x-text="cartItem.quantity"></span>
                <button @click="updateQuantity(index, 1)" class="w-6 h-6 flex items-center justify-center font-bold text-stone-600 hover:bg-stone-200 rounded transition">+</button>
              </div>
            </div>
          </template>
        </div>

        <!-- Order Summary & Checkout -->
        <div x-show="cart.length > 0" class="border-t border-stone-200 mt-4 pt-4 space-y-4" x-cloak>
          <div class="flex justify-between items-center font-bold text-lg text-stone-900">
            <span>Total:</span>
            <span x-text="'$' + cartTotal()"></span>
          </div>
          
          <button @click="alert('Thank you! In a full commercial setup, this button will submit the order to the kitchen or open a payment screen.')" 
                  class="w-full bg-amber-800 text-white font-bold py-3 rounded-xl shadow-md hover:bg-amber-900 transition flex items-center justify-center gap-2">
            <span>Place Order</span>
          </button>
        </div>

      </div>
    </div>

  </main>

  <!-- APP LOGIC (Alpine.js State) -->
  <script>
    function menuApp() {
      return {
        cart: [],
        menu: {
          "Appetizers & Snacks (Khaja)": [
            { id: 1, name: "Momo (Steamed or Fried)", price: 10, description: "Delicate handcrafted dumplings filled with spiced minced chicken, buffalo, or seasonal vegetables, served with a signature warm sesame-tomato chutney (Golbheda ko Achar).", options: ["Steamed", "Fried"], selectedOption: "Steamed", variants: ["Chicken", "Buffalo", "Vegetable"], selectedVariant: "Chicken" },
            { id: 2, name: "Choila", price: 10, description: "A Newari specialty featuring flame-grilled meat marinated in raw mustard oil, garlic, ginger, green chilies, and toasted fenugreek seeds. Comes with chiura (flattened rice).", variants: ["Chicken", "Buffalo"], selectedVariant: "Chicken" },
            { id: 3, name: "Bara (Wo)", price: 10, description: "Savory, pan-fried black lentil patties served plain, topped with an egg, or layered with minced meat. 2 Bara with potato soup.", options: ["Plain", "With Egg", "With Minced Meat"], selectedOption: "Plain" },
            { id: 4, name: "Aloo Dum & Bhutun", price: 10, description: "Spicy Himalayan-style dry potato curry served alongside pan-fried spiced offal (optional traditional delicacy). Comes with chiura (flattened rice)." }
          ],
          "Signature Thali Sets (Dal Bhat Power)": [
            { id: 5, name: "Authentic Non-Veg Thali", price: 15, description: "A classic, nourishing platter featuring steamed aromatic Basmati rice, slow-simmered yellow lentils (Dal), stir-fried mustard greens (Saag), mixed seasonal vegetable curry, house-made fermented radish pickle (Mula ko Achar), and crispy papad.", variants: ["Local Chicken Curry", "Tender Mutton Curry"], selectedVariant: "Local Chicken Curry" },
{ id: 6, name: "Traditional Vegetarian Thali", price: 15, description: "Steamed rice served with yellow lentils, butter paneer or cottage cheese curry, seasonal vegetable tarkari, Jimbu-tempered saag, fresh cucumber-yogurt salad, and mixed fruit-spiced pickle." }
],
"Chef’s Regional Specialties": [
{ id: 7, name: "Kwati Soup", price: 15, description: "A nutrient-rich, comforting soup prepared from nine distinct varieties of sprouted beans, slow-cooked with ginger, ajwain, and garlic." },
{ id: 8, name: "Samay Baji Platter", price: 15, description: "A Newari ritual feast platter consisting of beaten rice (Chiura), choila, black-eyed peas (Bodi), spiced potato salad, boiled egg, fried ginger/garlic slices, and bara." },
{ id: 9, name: "Aloo Tama Bodi", price: 15, description: "Tangy curry made with fermented bamboo shoots, black-eyed peas, and potatoes cooked in a light, sour gravy." }
],
"Desserts (Mithai)": [
{ id: 10, name: "Yomari", price: 5, description: "Steamed rice-flour dumplings shaped like a lotus seed, filled with rich sweet Chaku (molasses) and toasted sesame seeds or Khoa.", options: ["Chaku & Sesame", "Khoa"], selectedOption: "Chaku & Sesame" },
{ id: 11, name: "Kheer", price: 5, description: "Traditional cardamom-infused rice pudding cooked slowly with whole milk, cashews, raisins, and coconut flakes." }
],
"Traditional Beverages": [
{ id: 12, name: "Nepali Milk Tea (Chhiya)", price: 1, description: "Himalayan black tea brewed with whole milk, fresh ginger, crushed cardamom, cloves, and cinnamon." },
{ id: 13, name: "Himalayan Herbal Infusion", price: 1, description: "Herbal tea made with wild rhododendron petals, lemongrass, and mint leaves." }
]
},
addToCart(item) {
// Construct customization labels dynamically based on options picked
let details = [];
if (item.options) details.push(item.selectedOption || item.options[0]);
if (item.variants) details.push(item.selectedVariant || item.variants[0]);
let configString = details.join(' / ');
// Look for an existing match in the cart with exact same options
let match = this.cart.find(c => c.id === item.id && c.customization === configString);
if (match) {
match.quantity++;
} else {
this.cart.push({
id: item.id,
name: item.name,
price: item.price,
quantity: 1,
customization: configString
});
}
},
updateQuantity(index, amount) {
this.cart[index].quantity += amount;
if (this.cart[index].quantity <= 0) {
this.cart.splice(index, 1);
}
},
cartCount() {
return this.cart.reduce((sum, i) => sum + i.quantity, 0);
},
cartTotal() {
return this.cart.reduce((sum, i) => sum + (i.price * i.quantity), 0);
}
}
}
